VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional alias (older name). Prefer VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- GitHub OAuth (Supabase Dashboard) ---
# 1. Authentication → Providers → GitHub: enable, paste GitHub Client ID + Secret
# 2. GitHub OAuth App → Authorization callback URL MUST be exactly:
#    https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#    (NOT the Vercel URL — wrong callback causes github.com/sessions/verified-device)
# 3. Authentication → URL Configuration:
#    Site URL: https://phone-inventory-swart.vercel.app
#    Redirect URLs (add all):
#      http://localhost:5173/
#      http://localhost:5173/**
#      https://phone-inventory-swart.vercel.app/
#      https://phone-inventory-swart.vercel.app/**
